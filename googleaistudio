<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TANVIR BOT - Dashboard</title>
    <!-- Google Fonts for Modern Look -->
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b141d;
            --card-bg: #0f1c29;
            --accent-blue: #00d2ff;
            --accent-pink: #ff00ff;
            --accent-green: #00ff88;
            --accent-red: #ff4b2b;
            --text-main: #ffffff;
            --text-muted: #8899a6;
            --input-bg: #070d14;
            --border-color: #1e2e3d;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        /* Header Styles */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--accent-blue);
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 2px;
            color: var(--accent-blue);
            text-transform: uppercase;
        }

        .top-stats {
            display: flex;
            gap: 15px;
            font-size: 12px;
            color: var(--text-muted);
        }

        .stat-item span { color: var(--accent-blue); }

        /* Navigation Tabs */
        .tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 20px;
            overflow-x: auto;
        }

        .tab {
            padding: 10px 20px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            text-transform: uppercase;
            transition: 0.3s;
        }

        .tab.active {
            border-bottom: 3px solid var(--accent-blue);
            background: rgba(0, 210, 255, 0.1);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--card-bg);
            padding: 15px;
            text-align: center;
            border-radius: 5px;
            border: 1px solid var(--border-color);
        }

        .stat-card h3 { margin: 0; font-size: 20px; }
        .stat-card p { margin: 5px 0 0; font-size: 10px; color: var(--text-muted); text-transform: uppercase; }
        .stat-card.failed h3 { color: var(--accent-red); }
        .stat-card.balance h3 { color: var(--accent-green); }

        /* Form Sections */
        .section-title {
            color: var(--accent-blue);
            font-size: 14px;
            margin-bottom: 15px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 11px;
            color: var(--text-muted);
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        input, textarea {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid var(--border-color);
            padding: 12px;
            color: #fff;
            border-radius: 4px;
            box-sizing: border-box;
            font-family: 'JetBrains Mono', monospace;
        }

        /* Chain Selection Grid */
        .chain-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px;
            margin-bottom: 20px;
        }

        .chain-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 8px;
            border-radius: 4px;
            font-size: 11px;
            color: #fff;
            text-align: center;
            cursor: pointer;
        }

        .chain-btn.active {
            border-color: var(--accent-blue);
            background: rgba(0, 210, 255, 0.1);
        }

        /* Warning & Status Box */
        .warning-box {
            background: rgba(255, 0, 85, 0.1);
            border: 1px solid var(--accent-red);
            padding: 10px;
            color: var(--accent-red);
            font-size: 12px;
            border-radius: 4px;
            margin-bottom: 15px;
        }

        .status-box {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid var(--accent-green);
            padding: 10px;
            color: var(--accent-green);
            font-size: 12px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Action Buttons */
        .btn-row {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 12px;
        }

        .btn-analyze { background: #1e2e3d; color: #fff; border: 1px solid var(--border-color); }
        .btn-supply { background: #fff; color: #000; }

        .mint-row {
            display: flex;
            gap: 15px;
        }
        .mint-row > div { flex: 1; }

    </style>
</head>
<body>

<div class="container">
    <!-- Header -->
    <header class="header">
        <div class="logo">🚀 TANVIR BOT</div>
        <div class="top-stats">
            <div class="stat-item">GAS: <span>0.0 Gwei</span></div>
            <div class="stat-item">BASE: <span>$0.0000</span></div>
            <div class="stat-item">IDLE</div>
        </div>
    </header>

    <!-- Tabs -->
    <nav class="tabs">
        <div class="tab active">🤖 BOT</div>
        <div class="tab">👛 WALLETS</div>
        <div class="tab">📡 RPC</div>
        <div class="tab">⛽ GAS</div>
        <div class="tab">📊 MONITOR</div>
    </nav>

    <!-- Main Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <h3>0</h3>
            <p>Minted</p>
        </div>
        <div class="stat-card failed">
            <h3>3</h3>
            <p>Failed</p>
        </div>
        <div class="stat-card">
            <h3>0.0</h3>
            <p>Gas Gwei</p>
        </div>
        <div class="stat-card balance">
            <h3>0.0000</h3>
            <p>Balance</p>
        </div>
    </div>

    <!-- Step 1 -->
    <div class="section-title">🔒 STEP 1 - CHAIN & WALLET</div>
    
    <label>Select Chain</label>
    <div class="chain-grid">
        <div class="chain-btn">ETH</div>
        <div class="chain-btn">BSC</div>
        <div class="chain-btn active">BASE</div>
        <div class="chain-btn">ARBITRUM</div>
        <div class="chain-btn">POLYGON</div>
        <div class="chain-btn">AVAX</div>
    </div>

    <div class="form-group">
        <label>RPC URL (ALCHEMY/INFURA)</label>
        <input type="text" value="https://base-mainnet.g.alchemy.com/v2/your-api-key" placeholder="Enter RPC URL">
    </div>

    <div class="form-group">
        <label>Private Key</label>
        <input type="password" value="••••••••••••••••••••••••••••••••••••••••••••••••••••" placeholder="Enter Private Key">
    </div>

    <div class="warning-box">
        ⚠️ Use dedicated hot wallet only. Never your main wallet.
    </div>

    <div class="status-box">
        ✅ 0xFa7F...BB2A7 | BASE | Private Key Loaded
    </div>

    <br><br>

    <!-- Step 2 -->
    <div class="section-title">📄 STEP 2 - CONTRACT</div>

    <div class="form-group">
        <label>Contract Address</label>
        <input type="text" placeholder="0x99bba4ddf1e5cd4dcdacd3b162e1ea2ba98908ec">
    </div>

    <div class="form-group">
        <label>ABI Fragment</label>
        <textarea rows="3">[{"inputs":[{"internalType":"address","name":"minter","type":"address"}]...}]</textarea>
    </div>

    <div class="mint-row">
        <div class="form-group">
            <label>Mint Price (ETH)</label>
            <input type="number" value="0">
        </div>
        <div class="form-group">
            <label>Qty per TX</label>
            <input type="number" value="1">
        </div>
    </div>

    <div class="btn-row">
        <button class="btn btn-analyze">🔍 ANALYZE</button>
        <button class="btn btn-supply">📊 SUPPLY: 12</button>
    </div>

    <div style="margin-top: 20px; font-size: 12px; color: var(--accent-green);">
        <p>✅ Contract deployed</p>
        <p style="color: var(--text-muted);">◽ totalSupply() - not available</p>
    </div>

</div>

</body>
</html>
