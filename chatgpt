<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Blockchain Bot Panel</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#0d1117;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.container{
    width:420px;
    background:#161b22;
    border-radius:20px;
    padding:25px;
    box-shadow:0 0 20px rgba(0,0,0,0.5);
}

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.top h2{
    font-size:24px;
}

.status{
    background:#00c853;
    padding:5px 12px;
    border-radius:20px;
    font-size:14px;
}

.card{
    background:#21262d;
    border-radius:15px;
    padding:20px;
    margin-bottom:20px;
}

.card h3{
    margin-bottom:15px;
    font-size:18px;
}

.input-group{
    margin-bottom:15px;
}

.input-group label{
    display:block;
    margin-bottom:6px;
    color:#8b949e;
}

.input-group input,
.input-group select{
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    background:#0d1117;
    color:white;
    outline:none;
}

.btn{
    width:100%;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#238636;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
}

.btn:hover{
    background:#2ea043;
}

.networks{
    display:flex;
    gap:10px;
    margin-top:15px;
}

.network{
    flex:1;
    background:#30363d;
    padding:12px;
    border-radius:10px;
    text-align:center;
    cursor:pointer;
    transition:0.3s;
}

.network:hover{
    background:#484f58;
}

.log{
    background:#0d1117;
    height:120px;
    overflow:auto;
    border-radius:10px;
    padding:10px;
    font-size:14px;
    color:#00ff99;
}

.footer{
    text-align:center;
    margin-top:15px;
    color:#8b949e;
    font-size:13px;
}
</style>
</head>

<body>

<div class="container">

    <div class="top">
        <h2>BOT PANEL</h2>
        <div class="status">ONLINE</div>
    </div>

    <div class="card">
        <h3>Mint Settings</h3>

        <div class="input-group">
            <label>Wallet Address</label>
            <input type="text" id="wallet" placeholder="0x....">
        </div>

        <div class="input-group">
            <label>Contract Address</label>
            <input type="text" id="contract" placeholder="0x....">
        </div>

        <div class="input-group">
            <label>Mint Amount</label>
            <input type="number" id="amount" value="1">
        </div>

        <div class="input-group">
            <label>Select Network</label>
            <select id="network">
                <option>Ethereum</option>
                <option>Polygon</option>
                <option>BSC</option>
                <option>Arbitrum</option>
            </select>
        </div>

        <button class="btn" onclick="startBot()">
            START BOT
        </button>

        <div class="networks">
            <div class="network">ETH</div>
            <div class="network">BSC</div>
            <div class="network">POLY</div>
        </div>

    </div>

    <div class="card">
        <h3>Bot Logs</h3>

        <div class="log" id="logs">
            Waiting for action...
        </div>
    </div>

    <div class="footer">
        Blockchain Mint Bot Interface
    </div>

</div>

<script>

function startBot(){

    let wallet = document.getElementById("wallet").value;
    let contract = document.getElementById("contract").value;
    let amount = document.getElementById("amount").value;
    let network = document.getElementById("network").value;

    let logs = document.getElementById("logs");

    if(wallet == "" || contract == ""){
        logs.innerHTML += "<br>❌ Please fill all fields";
        return;
    }

    logs.innerHTML += `
    <br>🚀 Bot Started
    <br>🌐 Network: ${network}
    <br>👛 Wallet: ${wallet}
    <br>📄 Contract: ${contract}
    <br>💰 Amount: ${amount}
    <br>✅ Transaction Ready...
    `;

}

</script>

</body>
</html>
