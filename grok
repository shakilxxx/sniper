<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TANVIR BOT - NFT SNIPER</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        
        :root {
            --neon-cyan: #00f5ff;
            --neon-green: #00ff9d;
            --neon-red: #ff2d55;
            --neon-purple: #c026d3;
        }
        
        body {
            font-family: 'Inter', system-ui, sans-serif;
        }
        
        .neon-text {
            text-shadow: 0 0 10px var(--neon-cyan);
        }
        
        .card {
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(0, 245, 255, 0.2);
        }
        
        .nav-active {
            border-bottom: 3px solid #00f5ff;
            color: #00f5ff;
        }
        
        .status-dot {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        
        .chain-btn {
            transition: all 0.3s ease;
        }
        
        .chain-btn.active {
            background-color: #22d3ee;
            color: black;
            box-shadow: 0 0 15px #22d3ee;
        }
    </style>
</head>
<body class="bg-[#0a0a0f] text-white min-h-screen">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <header class="border-b border-cyan-500/30 bg-black/80 backdrop-blur-md sticky top-0 z-50">
            <div class="flex items-center justify-between px-6 py-4">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-cyan-400 to-purple-500 rounded-xl flex items-center justify-center">
                        <i class="fa-solid fa-bullseye text-white text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold tracking-tighter neon-text">TANVIR BOT</h1>
                        <p class="text-xs text-cyan-400 -mt-1">NFT SNIPER • ALL EVM CHAINS • v5.0 • PRODUCTION</p>
                    </div>
                </div>
                
                <!-- Status -->
                <div class="flex items-center gap-8 text-sm">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 bg-green-500 rounded-full status-dot"></div>
                        <span class="text-green-400 font-medium">0xFa7F...</span>
                    </div>
                    
                    <div class="flex items-center gap-6">
                        <div>
                            <span class="text-cyan-400">BASE</span>
                        </div>
                        <div class="text-amber-400">
                            <i class="fa-solid fa-gas-pump"></i> 0.0 Gwei
                        </div>
                        <div class="text-emerald-400">
                            0.0000 ETH
                        </div>
                        <div class="flex items-center gap-1 text-yellow-400">
                            <i class="fa-solid fa-robot"></i>
                            <span class="font-medium">IDLE</span>
                        </div>
                        <div class="flex items-center gap-1 text-emerald-400">
                            <i class="fa-solid fa-check"></i> 0
                        </div>
                        <div class="flex items-center gap-1 text-red-400">
                            <i class="fa-solid fa-xmark"></i> 3
                        </div>
                    </div>
                </div>
                
                <div class="flex items-center gap-2 text-xs bg-zinc-900 px-4 py-2 rounded-full border border-cyan-500/30">
                    <div class="bg-green-500 w-2 h-2 rounded-full animate-pulse"></div>
                    Connected
                </div>
            </div>
            
            <!-- Navigation -->
            <div class="flex border-t border-cyan-500/20 px-6">
                <div onclick="switchTab(0)" class="nav-item nav-active px-8 py-4 text-sm font-medium cursor-pointer flex items-center gap-2 hover:text-cyan-400">
                    <i class="fa-solid fa-bullseye"></i>
                    BOT
                </div>
                <div onclick="switchTab(1)" class="nav-item px-8 py-4 text-sm font-medium cursor-pointer flex items-center gap-2 hover:text-cyan-400">
                    <i class="fa-solid fa-wallet"></i>
                    WALLETS
                </div>
                <div onclick="switchTab(2)" class="nav-item px-8 py-4 text-sm font-medium cursor-pointer flex items-center gap-2 hover:text-cyan-400">
                    <i class="fa-solid fa-plug"></i>
                    RPC
                </div>
                <div onclick="switchTab(3)" class="nav-item px-8 py-4 text-sm font-medium cursor-pointer flex items-center gap-2 hover:text-cyan-400">
                    <i class="fa-solid fa-fire"></i>
                    GAS
                </div>
                <div onclick="switchTab(4)" class="nav-item px-8 py-4 text-sm font-medium cursor-pointer flex items-center gap-2 hover:text-cyan-400">
                    <i class="fa-solid fa-chart-line"></i>
                    MONITOR
                </div>
                <div onclick="switchTab(5)" class="nav-item px-8 py-4 text-sm font-medium cursor-pointer flex items-center gap-2 hover:text-cyan-400">
                    <i class="fa-solid fa-file-lines"></i>
                    LOG
                </div>
            </div>
        </header>

        <div class="p-6 grid grid-cols-12 gap-6">
            <!-- Stats -->
            <div class="col-span-12 grid grid-cols-4 gap-4">
                <div class="card rounded-2xl p-6 border border-cyan-500/30">
                    <div class="text-cyan-400 text-sm mb-1">MINTED</div>
                    <div class="text-5xl font-bold text-cyan-400">0</div>
                </div>
                <div class="card rounded-2xl p-6 border border-red-500/30">
                    <div class="text-red-400 text-sm mb-1">FAILED</div>
                    <div class="text-5xl font-bold text-red-400">3</div>
                </div>
                <div class="card rounded-2xl p-6 border border-amber-500/30">
                    <div class="text-amber-400 text-sm mb-1">GAS GWEI</div>
                    <div class="text-5xl font-bold text-amber-400">0.0</div>
                </div>
                <div class="card rounded-2xl p-6 border border-emerald-500/30">
                    <div class="text-emerald-400 text-sm mb-1">BALANCE</div>
                    <div class="text-5xl font-bold text-emerald-400">0.0000</div>
                </div>
            </div>

            <!-- Step 1 -->
            <div class="col-span-12 lg:col-span-7">
                <div class="card rounded-3xl p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-yellow-500 text-black text-xs font-bold px-3 py-1 rounded-lg">STEP 1</div>
                        <h2 class="text-2xl font-bold">CHAIN & WALLET</h2>
                    </div>
                    
                    <!-- Chain Selection -->
                    <div class="mb-8">
                        <div class="flex items-center gap-2 mb-4">
                            <i class="fa-solid fa-bolt text-yellow-400"></i>
                            <span class="text-sm font-medium">EVM L1</span>
                        </div>
                        <div class="grid grid-cols-5 gap-3 mb-6">
                            <button onclick="selectChain(this)" class="chain-btn active flex flex-col items-center gap-2 py-4 rounded-2xl border border-cyan-400">
                                <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-xs">ETH</div>
                                <span class="text-xs">ETH</span>
                            </button>
                            <button onclick="selectChain(this)" class="chain-btn flex flex-col items-center gap-2 py-4 rounded-2xl border border-amber-400">
                                <div class="w-8 h-8 bg-yellow-500 rounded-full flex items-center justify-center text-xs">BSC</div>
                                <span class="text-xs">BSC</span>
                            </button>
                            <button onclick="selectChain(this)" class="chain-btn flex flex-col items-center gap-2 py-4 rounded-2xl border border-purple-400">
                                <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-xs">POLY</div>
                                <span class="text-xs">POLYGON</span>
                            </button>
                            <button onclick="selectChain(this)" class="chain-btn flex flex-col items-center gap-2 py-4 rounded-2xl border border-red-400">
                                <div class="w-8 h-8 bg-red-500 rounded-full flex items-center justify-center text-xs">AVAX</div>
                                <span class="text-xs">AVAX</span>
                            </button>
                            <button onclick="selectChain(this)" class="chain-btn flex flex-col items-center gap-2 py-4 rounded-2xl border border-white">
                                <div class="w-8 h-8 bg-white rounded-full flex items-center justify-center text-xs">FTM</div>
                                <span class="text-xs">FTM</span>
                            </button>
                        </div>
                        
                        <!-- L2 -->
                        <div class="mb-4">
                            <div class="flex items-center gap-2 mb-3">
                                <span class="text-sm font-medium text-cyan-400">L2 ROLLUPS</span>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                <button onclick="selectL2(this)" class="chain-btn active px-6 py-3 rounded-2xl text-sm flex items-center gap-2 border border-red-500">
                                    <span class="text-red-500 font-bold">B</span> BASE
                                </button>
                                <button onclick="selectL2(this)" class="chain-btn px-6 py-3 rounded-2xl text-sm flex items-center gap-2 border border-blue-500">
                                    ARBITRUM
                                </button>
                                <button onclick="selectL2(this)" class="chain-btn px-6 py-3 rounded-2xl text-sm flex items-center gap-2 border border-red-500">
                                    OPTIMISM
                                </button>
                                <button onclick="selectL2(this)" class="chain-btn px-6 py-3 rounded-2xl text-sm flex items-center gap-2 border border-cyan-500">
                                    ZKSYNC
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- RPC -->
                    <div class="mb-8">
                        <label class="block text-sm text-cyan-400 mb-2">ALCHEMY/INFURA RPC URL</label>
                        <div class="relative">
                            <input type="text" id="rpc-url" 
                                   value="https://base-mainnet.g.alchemy.com/v2/BNPpjAPpQMojMaorwUGIH"
                                   class="w-full bg-zinc-950 border border-cyan-500/50 rounded-2xl px-5 py-4 text-sm focus:outline-none focus:border-cyan-400">
                            <button class="absolute right-3 top-1/2 -translate-y-1/2 bg-cyan-500 hover:bg-cyan-400 text-black font-bold px-6 py-2 rounded-xl text-sm">
                                TEST
                            </button>
                        </div>
                    </div>
                    
                    <!-- Private Key -->
                    <div>
                        <label class="block text-sm text-cyan-400 mb-2">PRIVATE KEY</label>
                        <input type="password" id="private-key" 
                               value="••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••"
                               class="w-full bg-zinc-950 border border-cyan-500/50 rounded-2xl px-5 py-4 text-sm focus:outline-none focus:border-cyan-400">
                    </div>
                    
                    <!-- Warning -->
                    <div class="mt-6 bg-red-950/50 border border-red-500/50 text-red-400 text-sm p-4 rounded-2xl flex gap-3">
                        <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                        <span>Use dedicated hot wallet only. Never your main wallet.</span>
                    </div>
                    
                    <!-- Connected Wallet -->
                    <div class="mt-8 bg-emerald-950/50 border border-emerald-500/50 p-5 rounded-2xl flex items-center gap-4">
                        <div class="bg-emerald-500 text-black w-8 h-8 rounded-2xl flex items-center justify-center">
                            <i class="fa-solid fa-check"></i>
                        </div>
                        <div class="text-sm">
                            <div class="font-mono text-emerald-400">0xFa7F72B3f9e1dD51C903FB4C7d42fd1C433BB2A7</div>
                            <div class="text-emerald-500">BASE • Private Key</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Step 2 -->
            <div class="col-span-12 lg:col-span-5">
                <div class="card rounded-3xl p-8 h-full">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="bg-cyan-500 text-black text-xs font-bold px-3 py-1 rounded-lg">STEP 2</div>
                        <h2 class="text-2xl font-bold">CONTRACT</h2>
                    </div>
                    
                    <!-- Contract Address -->
                    <div class="mb-6">
                        <label class="block text-sm text-cyan-400 mb-2">CONTRACT ADDRESS</label>
                        <input type="text" value="0x99bba4ddf1e5cd4dcdacd3b162e1ea2ba98908ec"
                               class="w-full bg-zinc-950 border border-cyan-500/50 rounded-2xl px-5 py-4 font-mono text-sm focus:outline-none focus:border-cyan-400">
                    </div>
                    
                    <!-- Mint Function -->
                    <div class="grid grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="block text-sm text-cyan-400 mb-2">MINT FUNCTION</label>
                            <div class="bg-zinc-900 border border-cyan-500/50 rounded-2xl px-5 py-4 text-lg font-medium">mint</div>
                        </div>
                        <div>
                            <label class="block text-sm text-cyan-400 mb-2">QTY PER TX</label>
                            <input type="number" value="1" 
                                   class="w-full bg-zinc-950 border border-cyan-500/50 rounded-2xl px-5 py-4 text-center text-xl font-bold focus:outline-none focus:border-cyan-400">
                        </div>
                    </div>
                    
                    <!-- ABI -->
                    <div class="mb-6">
                        <label class="block text-sm text-cyan-400 mb-2">ABI FRAGMENT</label>
                        <textarea class="w-full h-32 bg-zinc-950 border border-cyan-500/50 rounded-2xl p-5 text-xs font-mono resize-none focus:outline-none focus:border-cyan-400">[{"inputs":[{"internalType":"address","name":"minter","type":"address"},{"internalType":"uint256","name":"quantity","type":"uint256"}],"name":"mint","outputs":[],"stateMutability":"nonpayable","type":"function"}]</textarea>
                    </div>
                    
                    <!-- Price -->
                    <div class="grid grid-cols-2 gap-6 mb-8">
                        <div>
                            <label class="block text-sm text-cyan-400 mb-2">MINT PRICE (ETH)</label>
                            <input type="text" value="0" 
                                   class="w-full bg-zinc-950 border border-cyan-500/50 rounded-2xl px-5 py-4 text-center text-2xl font-bold focus:outline-none focus:border-cyan-400">
                        </div>
                        <div class="flex flex-col justify-end">
                            <button onclick="analyzeContract()" 
                                    class="bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-400 hover:to-purple-400 text-black font-bold py-4 px-8 rounded-2xl text-sm tracking-wider">
                                ANALYZE CONTRACT
                            </button>
                        </div>
                    </div>
                    
                    <!-- Supply -->
                    <div class="bg-zinc-900 rounded-2xl p-6 mb-6">
                        <div class="flex justify-between items-center">
                            <button class="flex items-center gap-2 text-cyan-400">
                                <i class="fa-solid fa-layer-group"></i>
                                <span class="font-medium">SUPPLY</span>
                            </button>
                            <div class="text-3xl font-bold text-cyan-400">12</div>
                        </div>
                    </div>
                    
                    <!-- Status -->
                    <div class="space-y-3 text-sm">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" checked class="w-5 h-5 accent-cyan-500">
                            <span>Contract deployed</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <input type="checkbox" class="w-5 h-5 accent-cyan-500">
                            <span>totalSupply() — not available</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <input type="checkbox" class="w-5 h-5 accent-cyan-500">
                            <span>maxSupply() — not available</span>
                        </div>
                    </div>
                    
                    <button onclick="startBot()" 
                            class="mt-10 w-full bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 text-white font-bold py-6 rounded-3xl text-xl tracking-widest shadow-lg shadow-red-500/50">
                        START SNIPER
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function switchTab(n) {
            document.querySelectorAll('.nav-item').forEach((el, i) => {
                if(i === n) {
                    el.classList.add('nav-active');
                } else {
                    el.classList.remove('nav-active');
                }
            });
        }
        
        function selectChain(el) {
            document.querySelectorAll('.chain-btn').forEach(btn => btn.classList.remove('active'));
            el.classList.add('active');
        }
        
        function selectL2(el) {
            document.querySelectorAll('.chain-btn').forEach(btn => btn.classList.remove('active'));
            el.classList.add('active');
        }
        
        function analyzeContract() {
            alert("✅ Contract analyzed successfully!\n\nTotal Supply: 12\nMint Function: mint\nStatus: Ready");
        }
        
        function startBot() {
            const btn = event.target;
            btn.innerHTML = `
                <div class="flex items-center justify-center gap-3">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    SNIPING IN PROGRESS...
                </div>
            `;
            btn.disabled = true;
            
            setTimeout(() => {
                alert("🚀 Bot started successfully!\n\nMonitoring for mint opportunity...");
            }, 800);
        }
        
        // Tailwind script already included
        console.log("%cTANVIR BOT UI Loaded Successfully ✅", "color: #00f5ff; font-size: 16px; font-weight: bold");
    </script>
</body>
</html>
