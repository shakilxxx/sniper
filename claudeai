    <!-- STEP 3: TIMING -->
    <div class="section">
      <div class="section-header">
        <span>⏰</span>
        <span class="section-title">Step 3 — Timing</span>
      </div>
      <div class="section-body">
        <div class="timing-row">
          <div>
            <div class="field-label">MODE</div>
            <select class="field-select" id="timing-mode">
              <option value="immediate">Immediate</option>
              <option value="scheduled">Scheduled Time</option>
              <option value="block">Target Block</option>
              <option value="watch">Watch &amp; Mint</option>
            </select>
          </div>
          <div>
            <div class="field-label">TARGET DATE/TIME (UTC)</div>
            <input class="field-input" type="datetime-local" id="target-time">
          </div>
          <div>
            <div class="field-label">RETRY COUNT</div>
            <input class="field-input" type="number" id="retry-count" value="5" min="1" max="50">
          </div>
        </div>

        <div class="field-label">MAX GAS (GWEI)</div>
        <div class="field-row">
          <input class="field-input" type="number" id="max-gas" placeholder="Auto" value="">
          <button class="btn btn-outline" onclick="fetchGas()">⛽ FETCH GAS</button>
          <span class="supply-badge" id="cur-gas-badge" style="align-self:center">Current: — Gwei</span>
        </div>
      </div>
    </div>

    <!-- STEP 4: START BOT -->
    <div class="section">
      <div class="section-header">
        <span>🚀</span>
        <span class="section-title">Step 4 — Run Bot</span>
      </div>
      <div class="section-body">
        <div class="bot-actions">
          <button class="big-btn start" id="start-btn" onclick="startBot()">▶ START BOT</button>
          <button class="big-btn stop" id="stop-btn" onclick="stopBot()" disabled style="opacity:0.4">■ STOP BOT</button>
          <button class="btn btn-outline" onclick="clearLog()" style="align-self:center">🗑 CLEAR LOG</button>
          <button class="btn btn-outline" onclick="testMint()" style="align-self:center">🧪 TEST MINT</button>
        </div>

        <div class="field-label" style="margin-top:14px">LIVE LOG</div>
        <div class="log-box" id="live-log">
          <div class="log-line err"><span class="log-time">[12:31:04]</span><span class="log-msg">TX Failed — insufficient gas. Retry 1/5</span></div>
          <div class="log-line err"><span class="log-time">[12:31:07]</span><span class="log-msg">TX Failed — nonce too low. Retry 2/5</span></div>
          <div class="log-line warn"><span class="log-time">[12:31:10]</span><span class="log-msg">RPC latency high: 820ms. Consider switching.</span></div>
          <div class="log-line info"><span class="log-time">[12:31:15]</span><span class="log-msg">Bot idle. Waiting for trigger...</span></div>
        </div>
      </div>
    </div>

  </div><!-- /bot tab -->

  <!-- WALLETS TAB -->
  <div id="tab-wallets" class="tab-content">
    <div class="section">
      <div class="section-header">
        <span>👜</span>
        <span class="section-title">Wallet Manager</span>
      </div>
      <div class="section-body">
        <div class="field-label">ADD WALLET (PRIVATE KEY)</div>
        <div class="field-row">
          <input class="field-input password" type="password" id="new-wallet-key" placeholder="0x...">
          <button class="btn btn-cyan" onclick="addWallet()">+ ADD</button>
        </div>
        <div class="check-list" id="wallet-list" style="margin-top:14px">
          <div class="check-item ok">
            <div class="dot">✓</div>
            <span>0xFa7F72B3f9e1dD51C903FB4C7d42fd1C433BB2A7 <span class="badge green">ACTIVE</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RPC TAB -->
  <div id="tab-rpc" class="tab-content">
    <div class="section">
      <div class="section-header">
        <span>📡</span>
        <span class="section-title">RPC Configuration</span>
      </div>
      <div class="section-body">
        <div class="field-label">CUSTOM RPC ENDPOINTS</div>
        <textarea class="abi-textarea" placeholder="One RPC URL per line...
https://mainnet.infura.io/v3/YOUR_KEY
https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"></textarea>
        <div class="field-row" style="margin-top:10px">
          <button class="btn btn-cyan" onclick="benchmarkRPC()">📊 BENCHMARK ALL</button>
          <button class="btn btn-outline">SAVE</button>
        </div>
        <div class="alert success" style="margin-top:14px" id="rpc-benchmark-result" hidden>
          ✅ Best RPC: base-mainnet.g.alchemy.com — 42ms
        </div>
      </div>
    </div>
  </div>

  <!-- GAS TAB -->
  <div id="tab-gas" class="tab-content">
    <div class="section">
      <div class="section-header">
        <span>⛽</span>
        <span class="section-title">Gas Settings</span>
      </div>
      <div class="section-body">
        <div class="grid2">
          <div>
            <div class="field-label">GAS STRATEGY</div>
            <select class="field-select">
              <option>Auto (Market)</option>
              <option>Aggressive (+30%)</option>
              <option>Ultra (+100%)</option>
              <option>Manual</option>
            </select>
          </div>
          <div>
            <div class="field-label">PRIORITY FEE (GWEI)</div>
            <input class="field-input" type="number" placeholder="1.5" value="1.5">
          </div>
          <div>
            <div class="field-label">MAX FEE (GWEI)</div>
            <input class="field-input" type="number" placeholder="50">
          </div>
          <div>
            <div class="field-label">GAS LIMIT</div>
            <input class="field-input" type="number" placeholder="Auto" >
          </div>
        </div>
        <button class="btn btn-cyan" style="margin-top:14px" onclick="fetchGas()">⛽ REFRESH GAS ORACLE</button>
      </div>
    </div>
  </div>

  <!-- MONITOR TAB -->
  <div id="tab-monitor" class="tab-content">
    <div class="section">
      <div class="section-header">
        <span>📊</span>
        <span class="section-title">Transaction Monitor</span>
      </div>
      <div class="section-body" style="padding:0">
        <table class="monitor-table">
          <thead>
            <tr>
              <th>TX HASH</th>
              <th>STATUS</th>
              <th>GAS USED</th>
              <th>TIME</th>
              <th>CHAIN</th>
            </tr>
          </thead>
          <tbody id="monitor-tbody">
            <tr>
              <td>0xfa3e...44b1</td>
              <td><span class="badge red">FAILED</span></td>
              <td>21000</td>
              <td>12:31:04</td>
              <td>BASE</td>
            </tr>
            <tr>
              <td>0x9bc2...11d4</td>
              <td><span class="badge red">FAILED</span></td>
              <td>21000</td>
              <td>12:31:07</td>
              <td>BASE</td>
            </tr>
            <tr>
              <td>0x3fa1...cc90</td>
              <td><span class="badge red">FAILED</span></td>
              <td>21000</td>
              <td>12:31:09</td>
              <td>BASE</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- LOG TAB -->
  <div id="tab-log" class="tab-content">
    <div class="section">
      <div class="section-header">
        <span>📋</span>
        <span class="section-title">Full Log</span>
        <button class="btn btn-outline" style="margin-left:auto;font-size:11px;padding:4px 10px" onclick="clearLog()">🗑 CLEAR</button>
      </div>
      <div class="section-body" style="padding:10px">
        <div class="log-box" id="full-log" style="height:400px">
          <div class="log-line err"><span class="log-time">[12:31:04]</span><span class="log-msg">TX Failed — insufficient gas. Retry 1/5</span></div>
          <div class="log-line err"><span class="log-time">[12:31:07]</span><span class="log-msg">TX Failed — nonce too low. Retry 2/5</span></div>
          <div class="log-line warn"><span class="log-time">[12:31:10]</span><span class="log-msg">RPC latency high: 820ms. Consider switching.</span></div>
          <div class="log-line info"><span class="log-time">[12:31:15]</span><span class="log-msg">Bot idle. Waiting for trigger...</span></div>
        </div>
      </div>
    </div>
  </div>

</div><!-- /main -->

<script>
  // TAB SWITCH
  function switchTab(name, el) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('tab-' + name).classList.add('active');
  }

  // CHAIN SELECT
  let selectedChain = 'BASE';
  function selectChain(btn, chain) {
    document.querySelectorAll('.chain-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedChain = chain;
    document.querySelector('.header-stats .hstat.active-chain .val').textContent = chain;
    addLog('info', `Chain switched to ${chain}`);
  }

  // LOG SYSTEM
  function addLog(type, msg) {
    const now = new Date();
    const t = `[${now.getHours().toString().padStart(2,'0')}:${now.getMinutes().toString().padStart(2,'0')}:${now.getSeconds().toString().padStart(2,'0')}]`;
    const html = `<div class="log-line ${type}"><span class="log-time">${t}</span><span class="log-msg">${msg}</span></div>`;
    ['live-log', 'full-log'].forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.innerHTML += html; el.scrollTop = el.scrollHeight; }
    });
  }

  function clearLog() {
    ['live-log', 'full-log'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = '';
    });
  }

  // BOT START/STOP
  let botRunning = false;
  let botInterval = null;

  function startBot() {
    if (botRunning) return;
    botRunning = true;
    document.getElementById('start-btn').disabled = true;
    document.getElementById('start-btn').style.opacity = '0.4';
    document.getElementById('stop-btn').disabled = false;
    document.getElementById('stop-btn').style.opacity = '1';
    addLog('ok', `Bot started on ${selectedChain}. Monitoring contract...`);
    addLog('info', `Target: ${document.getElementById('contract-addr').value}`);
    botInterval = setInterval(simulateBot, 3000);
  }

  function stopBot() {
    botRunning = false;
    clearInterval(botInterval);
    document.getElementById('start-btn').disabled = false;
    document.getElementById('start-btn').style.opacity = '1';
    document.getElementById('stop-btn').disabled = true;
    document.getElementById('stop-btn').style.opacity = '0.4';
    addLog('warn', 'Bot stopped by user.');
  }

  let txCount = 0;
  function simulateBot() {
    const r = Math.random();
    if (r < 0.3) {
      addLog('ok', `TX Sent: 0x${Math.random().toString(16).slice(2,10)}...`);
      txCount++;
      document.getElementById('stat-minted').textContent = txCount;
      document.getElementById('minted-top').textContent = txCount;
    } else if (r < 0.6) {
      addLog('err', `TX Failed — ${['gas too low','nonce mismatch','contract reverted'][Math.floor(Math.random()*3)]}`);
    } else {
      addLog('info', `Block #${Math.floor(Math.random()*1000000+20000000)} — Watching...`);
    }
    // update gas randomly
    const g = (Math.random() * 5).toFixed(2);
    document.getElementById('stat-gas').textContent = g;
    document.getElementById('gwei-top').textContent = g;
  }

  // TEST MINT
  function testMint() {
    addLog('info', 'Simulating test mint (no real TX)...');
    setTimeout(() => addLog('ok', 'Simulation OK — ABI parsed, gas estimated ~52000'), 800);
  }

  // ANALYZE CONTRACT
  function analyzeContract() {
    addLog('info', `Analyzing contract ${document.getElementById('contract-addr').value.slice(0,10)}...`);
    setTimeout(() => {
      addLog('ok', 'Contract deployed ✓');
      addLog('warn', 'totalSupply() not found in ABI');
      addLog('warn', 'maxSupply() not found in ABI');
    }, 1200);
  }

  // CHECK SUPPLY
  function checkSupply() {
    addLog('info', 'Fetching supply...');
    setTimeout(() => {
      const s = Math.floor(Math.random() * 1000);
      document.getElementById('supply-badge').textContent = `Supply: ${s}`;
      addLog('ok', `Current supply: ${s}`);
    }, 800);
  }

  // TEST RPC
  function testRPC() {
    const url = document.getElementById('rpc-url').value;
    addLog('info', `Testing RPC: ${url.slice(0, 40)}...`);
    setTimeout(() => {
      addLog('ok', `RPC OK — latency: ${Math.floor(Math.random()*200+30)}ms`);
    }, 900);
  }

  // FETCH GAS
  function fetchGas() {
    addLog('info', 'Fetching gas oracle...');
    setTimeout(() => {
      const g = (Math.random() * 5 + 0.5).toFixed(3);
      document.getElementById('cur-gas-badge').textContent = `Current: ${g} Gwei`;
      document.getElementById('stat-gas').textContent = g;
      document.getElementById('gwei-top').textContent = g;
      addLog('ok', `Gas oracle: ${g} Gwei`);
    }, 700);
  }

  // BENCHMARK RPC
  function benchmarkRPC() {
    addLog('info', 'Benchmarking RPC endpoints...');
    setTimeout(() => {
      const el = document.getElementById('rpc-benchmark-result');
      el.hidden = false;
      addLog('ok', 'Benchmark complete.');
    }, 1500);
  }

  // ADD WALLET
  function addWallet() {
    const key = document.getElementById('new-wallet-key').value;
    if (!key) return;
    const addr = '0x' + Math.random().toString(16).slice(2, 42).toUpperCase();
    const list = document.getElementById('wallet-list');
    const item = document.createElement('div');
    item.className = 'check-item ok';
    item.innerHTML = `<div class="dot">✓</div><span>${addr} <span class="badge cyan">NEW</span></span>`;
    list.appendChild(item);
    document.getElementById('new-wallet-key').value = '';
    addLog('ok', `Wallet added: ${addr}`);
  }

  // WALLET DISPLAY
  function updateWalletDisplay() {
    document.getElementById('wallet-status').textContent =
      '✅ Wallet connected | ' + selectedChain + ' | Private Key';
  }
</script>
</body>
</html>
